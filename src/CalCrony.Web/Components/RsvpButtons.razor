@* One button per RSVP option; clicking a choice you hold clears THAT choice (bot parity), and
   clicking another switches to it — or, on an event that allows multiple RSVPs, adds it beside
   the ones you hold, so several buttons can be selected at once. Buttons freeze once the RSVP
   cutoff passes, and a full attending option reads as "join waitlist". A role-restricted option
   stays enabled and marked 🔒 — the web can't see the caller's roles, so there is no client-side
   prediction: the API's refusal (403 or 409) lands in the line below. *@
@implements IDisposable
<div class="d-flex flex-wrap gap-2">
    @foreach (var option in Event.Options.OrderBy(o => o.SortOrder))
    {
        var isMine = MyOptionIds.Contains(option.Id);
        <button type="button"
                class="rsvp-btn @(isMine ? "selected" : null)"
                disabled="@(busy || Closed)"
                title="@RestrictionTitle(option)"
                @onclick="() => ClickAsync(option.Id, isMine)">
            @option.Emote @option.Label@(CapacityBadge(option))@(option.IsRestricted ? " 🔒" : "")
        </button>
    }
</div>
@if (Closed)
{
    <div class="meta-mono mt-2">🔒 RSVPs are closed for this event.</div>
}
else if (MyWaitlistPosition is int position)
{
    <div class="meta-mono mt-2">⏳ You're #@(position + 1) on the waitlist — you'll be moved up automatically when a spot frees.</div>
}
@if (Event.AllowMultipleRsvps && !Closed)
{
    <div class="meta-mono mt-2">☑️ Pick every option that applies — click a selected one to remove it.</div>
}
@if (error is not null)
{
    <div class="alert alert-danger mt-2 py-2">@error</div>
}

@code {
    [Parameter, EditorRequired] public EventDto Event { get; set; } = default!;

    [Parameter, EditorRequired] public long UserId { get; set; }

    [Parameter] public EventCallback<EventDto> OnChanged { get; set; }

    /// <summary>Raised once the cutoff passes on an open page, so a parent showing its own
    /// cutoff status (the detail page's "RSVPs close …" chip) re-renders with the buttons.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    [Inject] private CalCronyWebApiClient Api { get; set; } = default!;

    private bool busy;
    private string? error;
    private System.Threading.Timer? closeTimer;
    private DateTimeOffset? announcedClosedFor;

    /// <summary>Every option the viewer holds — one at most in single-choice mode, any number when
    /// the event allows multiple RSVPs; waitlisted rows count as held (the button is selected and
    /// clicking it withdraws from the queue).</summary>
    private HashSet<Guid> MyOptionIds => [.. Event.RsvpsFor(UserId).Select(r => r.OptionId)];

    private bool Closed => Event.RsvpsClosed(DateTimeOffset.UtcNow);

    protected override void OnParametersSet() => ArmCloseTimer();

    // Blazor won't re-render just because the wall clock passed the cutoff — schedule one render
    // at that instant so the buttons actually freeze on an open page. Re-armed on every parameter
    // change (the cutoff may have moved); a cutoff beyond the hop re-arms in day-long hops so
    // arbitrarily far cutoffs still freeze (Timer's own dueTime cap is ~49 days).
    private static readonly TimeSpan MaxTimerHop = TimeSpan.FromDays(1);

    private void ArmCloseTimer()
    {
        closeTimer?.Dispose();
        closeTimer = null;
        if (Event.RsvpClosesAtUtc is not { } closesAt)
        {
            return;
        }

        var due = closesAt - DateTimeOffset.UtcNow;
        if (due <= TimeSpan.Zero)
        {
            // Already closed when we got here — no timer will ever fire, so announce it now or a
            // parent that rendered while the cutoff was still open keeps a stale "RSVPs close …"
            // chip forever. (This component's own buttons are computed per render, so they are
            // already correct; only the parent needs telling.)
            AnnounceClosed(closesAt);
            return;
        }

        closeTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(async () =>
            {
                if (DateTimeOffset.UtcNow >= closesAt)
                {
                    // Parent first (its own cutoff chip), then this component's buttons — the
                    // parent's re-render doesn't reach here, since the Event parameter is unchanged.
                    await AnnounceClosedAsync(closesAt);
                    StateHasChanged();
                }
                else
                {
                    ArmCloseTimer();
                }
            }),
            null, due < MaxTimerHop ? due : MaxTimerHop, System.Threading.Timeout.InfiniteTimeSpan);
    }

    /// <summary>Raises <see cref="OnClosed"/> once per cutoff. The parent's re-render runs this
    /// component's OnParametersSet again, so without the guard an already-passed cutoff would
    /// announce itself on every render.</summary>
    /// <param name="closesAt">The cutoff being announced.</param>
    private void AnnounceClosed(DateTimeOffset closesAt) => _ = InvokeAsync(() => AnnounceClosedAsync(closesAt));

    /// <summary>Raises <see cref="OnClosed"/> once per cutoff.</summary>
    /// <param name="closesAt">The cutoff being announced.</param>
    /// <returns>The parent-notification task.</returns>
    private async Task AnnounceClosedAsync(DateTimeOffset closesAt)
    {
        if (announcedClosedFor == closesAt)
        {
            return;
        }

        announcedClosedFor = closesAt;
        await OnClosed.InvokeAsync();
    }

    public void Dispose() => closeTimer?.Dispose();

    private int? MyWaitlistPosition
    {
        get
        {
            var index = Event.Waitlist.ToList().FindIndex(r => r.UserId == UserId);
            return index >= 0 ? index : null;
        }
    }

    private string CapacityBadge(RsvpOptionDto option) =>
        option.Capacity is int cap ? $" ({Event.SeatedCount(option.Id)}/{cap})" : "";

    private static string? RestrictionTitle(RsvpOptionDto option) =>
        option.IsRestricted ? $"Limited to {RoleText.List(option.AllowedRoles!)}" : null;

    private async Task ClickAsync(Guid optionId, bool isMine)
    {
        busy = true;
        error = null;
        // Withdrawal is option-scoped in every mode: in single-choice mode the one row IS on this
        // option, and with multiple RSVPs the viewer's other seats must survive the click.
        var result = isMine
            ? await Api.DeleteRsvpOptionAsync(Event.Id, UserId, optionId)
            : await Api.PutRsvpAsync(Event.Id, UserId, optionId);
        busy = false;

        if (!result.Success || result.Value is null)
        {
            error = result.Error;
            return;
        }

        await OnChanged.InvokeAsync(result.Value);
    }
}
