@* Events | Polls | Templates | Activity pill switcher shown at the top of the guild pages.
   Activity is manager-only content, but the tab shows for everyone — like the settings page,
   the page itself explains what members can't see rather than hiding that it exists. *@
<div class="btn-group btn-group-sm" role="group" aria-label="Guild section">
    <a class="btn @(Active == "events" ? "btn-primary" : "btn-outline-primary")" href="/app/guilds/@GuildId/events">Events</a>
    <a class="btn @(Active == "polls" ? "btn-primary" : "btn-outline-primary")" href="/app/guilds/@GuildId/polls">Polls</a>
    <a class="btn @(Active == "templates" ? "btn-primary" : "btn-outline-primary")" href="/app/guilds/@GuildId/templates">Templates</a>
    <a class="btn @(Active == "activity" ? "btn-primary" : "btn-outline-primary")" href="/app/guilds/@GuildId/activity">Activity</a>
</div>

@code {
    [Parameter, EditorRequired] public long GuildId { get; set; }

    /// <summary>"events", "polls", "templates", or "activity".</summary>
    [Parameter, EditorRequired] public string Active { get; set; } = "events";
}
