@page "/app/guilds/{GuildId:long}/events/new"
@page "/app/events/{EventId:guid}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject CalCronyWebApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit event" : "New event") — CalCrony</PageTitle>

<p class="meta-mono text-uppercase mb-2"><a href="" @onclick="Back" @onclick:preventDefault>← Back</a></p>
<h1 class="h3">@(IsEdit ? "Edit event" : "New event")</h1>
@if (!IsEdit)
{
    <p class="text-body-secondary">Posts to this server's default events channel with RSVP buttons, just like <code>/create</code>.</p>
}

@if (loading)
{
    <div class="spinner-border text-primary" role="status"></div>
}
else
{
    <div class="card p-3" style="max-width:560px">
        @if (!IsEdit && templates.Count > 0)
        {
            <div class="mb-3">
                <label class="form-label" for="ev-template">Start from template</label>
                <select id="ev-template" class="form-select" @onchange="OnTemplateChanged">
                    <option value="" selected="@(selectedTemplateId is null)">(none)</option>
                    @foreach (var t in templates)
                    {
                        <option value="@t.Id" selected="@(t.Id == selectedTemplateId)">@t.Name</option>
                    }
                </select>
                @if (SelectedTemplate is { Notifications.Count: > 0 } selected)
                {
                    <div class="form-text text-primary">🔔 Includes @selected.Notifications.Count reminder@(selected.Notifications.Count == 1 ? "" : "s") — added to the event automatically.</div>
                }
                <div class="form-text">Picking a template fills the fields below (overwriting edits); everything stays editable.</div>
            </div>
        }
        <div class="mb-3">
            <label class="form-label" for="ev-title">Title</label>
            <input id="ev-title" class="form-control" maxlength="128" @bind="title" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="ev-when">When @(IsEdit ? "(leave blank to keep the current time)" : "")</label>
            <input id="ev-when" class="form-control" placeholder="tomorrow 6pm · in 3 hours · friday at 8" @bind="when" @bind:after="PreviewAsync" />
            @if (whenPreview is not null)
            {
                <div class="form-text text-primary">→ <LocalTime Utc="whenPreview.Value" /></div>
            }
            else if (whenError is not null)
            {
                <div class="form-text text-danger">@whenError</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="ev-desc">Description <span class="text-body-secondary">(optional)</span></label>
            <textarea id="ev-desc" class="form-control" rows="3" maxlength="4096" @bind="description"></textarea>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label" for="ev-duration">Duration (min)</label>
                <input id="ev-duration" class="form-control" type="number" min="1" max="1440" @bind="duration" />
            </div>
            <div class="col-6">
                <label class="form-label" for="ev-location">Location <span class="text-body-secondary">(optional)</span></label>
                <input id="ev-location" class="form-control" maxlength="256" @bind="location" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="ev-image">Image URL <span class="text-body-secondary">(optional)</span></label>
            <input id="ev-image" class="form-control" maxlength="512" @bind="imageUrl" />
        </div>

        <div class="mb-3">
            <label class="form-label d-block">RSVP options</label>
            @foreach (var (row, index) in optionRows.Select((r, i) => (r, i)))
            {
                <div class="d-flex gap-2 align-items-center mb-1">
                    <input type="radio" class="form-check-input mt-0 flex-shrink-0" name="ev-attending"
                           title="This option counts as attending" aria-label="Attending option"
                           checked="@row.IsAttending" @onchange="() => SetAttending(index)" />
                    <input class="form-control" style="width:4.5rem" maxlength="16"
                           aria-label="Option emoji" @bind="row.Emote" />
                    <input class="form-control" maxlength="64" placeholder="Label"
                           aria-label="Option label" @bind="row.Label" />
                    <input class="form-control" type="number" min="1" style="width:6rem" placeholder="cap"
                           aria-label="Option capacity" @bind="row.Capacity" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" aria-label="Remove option"
                            disabled="@(optionRows.Count == 1)" @onclick="() => RemoveOption(index)">✕</button>
                </div>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm mt-1"
                    disabled="@(optionRows.Count >= 10)" @onclick="AddOption">+ Add option</button>
            <div class="form-text">
                The selected radio marks the <b>attending</b> option — it drives attendee roles, threads,
                and availability. Give it a capacity and extra RSVPs queue on a waitlist, promoted
                automatically when a spot frees.
                @if (IsEdit)
                {
                    <text>Options keep their RSVPs when the label stays the same; an option with RSVPs can't be removed.</text>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="ev-rsvp-close">RSVPs close <span class="text-body-secondary">(optional)</span></label>
            <input id="ev-rsvp-close" class="form-control" placeholder="2h before · friday 5pm"
                   disabled="@clearRsvpClose" @bind="rsvpClose" />
            @if (IsEdit && currentRsvpClose is { } closesAt)
            {
                <div class="form-text">Currently closes <LocalTime Utc="closesAt" /> — type a new cutoff to replace it.</div>
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="ev-clear-close" @bind="clearRsvpClose" />
                    <label class="form-check-label" for="ev-clear-close">Remove the cutoff (RSVPs reopen)</label>
                </div>
            }
            else
            {
                <div class="form-text">After this, the RSVP buttons stop accepting changes.</div>
            }
        </div>

        @if (!IsEdit)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="ev-thread" @bind="wantsThread" />
                <label class="form-check-label" for="ev-thread">🧵 Create a discussion thread in Discord</label>
                <div class="form-text">Opens on the event message; "Going" RSVPers are added automatically and it archives when the event ends.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="ev-repeat">Repeats</label>
                <select id="ev-repeat" class="form-select" @bind="repeatKind">
                    <option value="@RepeatKind.None">Doesn't repeat</option>
                    <option value="@RepeatKind.Daily">Daily</option>
                    <option value="@RepeatKind.Weekly">Weekly</option>
                    <option value="@RepeatKind.MonthlySameDate">Monthly (same date)</option>
                    <option value="@RepeatKind.MonthlyNthWeekday">Monthly (nth weekday, e.g. 3rd Friday)</option>
                    <option value="@RepeatKind.Yearly">Yearly</option>
                </select>
            </div>

            @if (repeatKind != RepeatKind.None)
            {
                <div class="mb-3">
                    <label class="form-label" for="ev-interval">Every</label>
                    <div class="d-flex align-items-center gap-2">
                        <input id="ev-interval" class="form-control" type="number" min="1" max="12" style="width:6rem" @bind="repeatInterval" />
                        <span class="text-body-secondary">@UnitLabel</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label d-block">Ends</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ev-ends" id="ev-ends-never"
                               checked="@(endMode == EndMode.Never)" @onchange="() => endMode = EndMode.Never" />
                        <label class="form-check-label" for="ev-ends-never">Never</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ev-ends" id="ev-ends-until"
                               checked="@(endMode == EndMode.Until)" @onchange="() => endMode = EndMode.Until" />
                        <label class="form-check-label" for="ev-ends-until">On a date</label>
                    </div>
                    @if (endMode == EndMode.Until)
                    {
                        <div class="ms-4 mb-2">
                            <input class="form-control form-control-sm" placeholder="Aug 30 · in 2 months" aria-label="Repeat until"
                                   @bind="repeatUntil" @bind:after="PreviewUntilAsync" />
                            @if (untilPreview is not null)
                            {
                                <div class="form-text text-primary mb-0">→ last on <LocalTime Utc="untilPreview.Value" Format="D" /></div>
                            }
                            else if (untilError is not null)
                            {
                                <div class="form-text text-danger mb-0">@untilError</div>
                            }
                        </div>
                    }
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="ev-ends" id="ev-ends-count"
                               checked="@(endMode == EndMode.Count)" @onchange="() => endMode = EndMode.Count" />
                        <label class="form-check-label" for="ev-ends-count">After a number of times</label>
                    </div>
                    @if (endMode == EndMode.Count)
                    {
                        <div class="ms-4">
                            <input class="form-control form-control-sm" type="number" min="2" max="500" style="width:8rem"
                                   aria-label="Repeat count" @bind="repeatCount" />
                        </div>
                    }
                </div>

                @if (RepeatPreview is not null)
                {
                    <p class="meta-mono">🔁 @RepeatPreview</p>
                }
            }
        }
        else if (recurrenceSummary is not null)
        {
            <p class="meta-mono">🔁 @recurrenceSummary — change or stop the schedule from the event page's <b>Edit schedule</b> button.</p>
        }

        @if (IsEdit && attendeeRoleId is not null)
        {
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="ev-clear-role" @bind="clearAttendeeRole" />
                <label class="form-check-label" for="ev-clear-role">
                    Remove attendee role (#@attendeeRoleId) — existing grants are removed too
                </label>
                <div class="form-text">Picking a different role happens in Discord with <code>/edit</code>.</div>
            </div>
        }

        @if (error is not null)
        {
            <div class="alert alert-danger py-2">@error</div>
        }

        @if (!askingScope)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveClickedAsync" disabled="@busy">@(IsEdit ? "Save changes" : "Create event")</button>
                <button class="btn btn-outline-secondary" @onclick="Back" disabled="@busy">Cancel</button>
            </div>
        }
        else
        {
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <span class="me-1">Apply to:</span>
                <button class="btn btn-primary btn-sm" @onclick="() => SaveAsync(EditScope.Occurrence)" disabled="@busy">This occurrence</button>
                <button class="btn btn-primary btn-sm" @onclick="() => SaveAsync(EditScope.Series)" disabled="@busy">Whole series</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => askingScope = false" disabled="@busy">Cancel</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public long GuildId { get; set; }

    [Parameter] public Guid? EventId { get; set; }

    [SupplyParameterFromQuery(Name = "template")]
    public Guid? TemplateId { get; set; }

    private enum RepeatKind { None, Daily, Weekly, MonthlySameDate, MonthlyNthWeekday, Yearly }

    private enum EndMode { Never, Until, Count }

    private bool IsEdit => EventId is not null;

    private bool loading = true;
    private bool busy;
    private string title = "";
    private string when = "";
    private string? description;
    private int? duration;
    private string? location;
    private string? imageUrl;
    private string? error;
    private DateTimeOffset? whenPreview;
    private string? whenError;
    private long backGuildId;
    private RepeatKind repeatKind = RepeatKind.None;
    private int repeatInterval = 1;
    private EndMode endMode = EndMode.Never;
    private string repeatUntil = "";
    private DateTimeOffset? untilPreview;
    private string? untilError;
    private int? repeatCount = 5;
    private string? recurrenceSummary;
    private bool editTargetIsLive;
    private bool askingScope;
    private long? attendeeRoleId;
    private bool clearAttendeeRole;
    private bool wantsThread;
    private List<OptionRow> optionRows = DefaultOptionRows();
    private List<RsvpOptionSpec>? loadedOptionSpecs;
    private string rsvpClose = "";
    private bool clearRsvpClose;
    private DateTimeOffset? currentRsvpClose;
    private List<EventTemplateDto> templates = [];
    private Guid? selectedTemplateId;
    private long? templatesLoadedForGuild;

    /// <summary>One editable RSVP option row; mirrors RsvpOptionSpec but mutable for binding.</summary>
    private sealed class OptionRow
    {
        public string Emote { get; set; } = "🔹";

        public string Label { get; set; } = "";

        public int? Capacity { get; set; }

        public bool IsAttending { get; set; }
    }

    private static List<OptionRow> DefaultOptionRows() =>
    [
        new() { Emote = "✅", Label = "Going", IsAttending = true },
        new() { Emote = "❌", Label = "Not going" },
        new() { Emote = "🤔", Label = "Maybe" },
    ];

    private void SetAttending(int index)
    {
        foreach (var (row, i) in optionRows.Select((r, i) => (r, i)))
        {
            row.IsAttending = i == index;
        }
    }

    private void AddOption() => optionRows.Add(new OptionRow());

    /// <summary>The submitted shape of the option rows (trimmed, so an untouched form compares
    /// equal to what was loaded).</summary>
    private static List<RsvpOptionSpec> ToSpecs(IEnumerable<OptionRow> rows) =>
        [.. rows.Select(r => new RsvpOptionSpec(r.Emote.Trim(), r.Label.Trim(), r.Capacity, r.IsAttending))];

    private void RemoveOption(int index)
    {
        var wasAttending = optionRows[index].IsAttending;
        optionRows.RemoveAt(index);
        if (wasAttending && optionRows.Count > 0)
        {
            optionRows[0].IsAttending = true;
        }
    }

    private EventTemplateDto? SelectedTemplate =>
        templates.FirstOrDefault(t => t.Id == selectedTemplateId);

    private string UnitLabel => repeatKind switch
    {
        RepeatKind.Daily => repeatInterval == 1 ? "day" : "days",
        RepeatKind.Weekly => repeatInterval == 1 ? "week" : "weeks",
        RepeatKind.Yearly => repeatInterval == 1 ? "year" : "years",
        _ => repeatInterval == 1 ? "month" : "months",
    };

    // Client-side preview only — the server's summary is the source of truth after save.
    private string? RepeatPreview
    {
        get
        {
            if (repeatKind == RepeatKind.None)
            {
                return null;
            }

            var local = whenPreview?.ToLocalTime();
            var every = repeatInterval == 1 ? "" : $"every {repeatInterval} ";
            var body = repeatKind switch
            {
                RepeatKind.Daily => repeatInterval == 1 ? "daily" : $"every {repeatInterval} days",
                RepeatKind.Weekly =>
                    $"{(every == "" ? "weekly" : every + "weeks")}{(local is null ? "" : $" on {local.Value.DayOfWeek}")}",
                RepeatKind.MonthlySameDate =>
                    $"{(every == "" ? "monthly" : every + "months")}{(local is null ? "" : $" on day {local.Value.Day}")}",
                RepeatKind.Yearly =>
                    $"{(every == "" ? "yearly" : every + "years")}{(local is null ? "" : $" on {local.Value:MMM d}")}",
                _ =>
                    $"{(every == "" ? "monthly" : every + "months")}{(local is null ? "" : $" on the {Nth(local.Value.Day)} {local.Value.DayOfWeek}")}",
            };
            return $"Repeats {body}";
        }
    }

    private static string Nth(int day) => ((day + 6) / 7) switch
    {
        1 => "1st", 2 => "2nd", 3 => "3rd", 4 => "4th", _ => "last",
    };

    protected override async Task OnParametersSetAsync()
    {
        backGuildId = GuildId;
        if (!IsEdit && templatesLoadedForGuild != GuildId)
        {
            // Once per guild: a reused component instance must not keep another guild's
            // templates or a stale selection, and re-running would clobber user edits.
            templatesLoadedForGuild = GuildId;
            selectedTemplateId = null;
            optionRows = DefaultOptionRows();
            rsvpClose = "";
            var loaded = await Api.ListTemplatesAsync(GuildId);
            // Failure just hides the picker — templates are a convenience, not a requirement.
            templates = loaded.Success ? loaded.Value ?? [] : [];
            if (TemplateId is { } preselected && templates.Any(t => t.Id == preselected))
            {
                selectedTemplateId = preselected;
                ApplyTemplate(SelectedTemplate!);
            }
        }

        if (IsEdit)
        {
            var result = await Api.GetEventAsync(EventId!.Value);
            if (!result.Success || result.Value is null)
            {
                error = result.Error ?? "Event not found.";
                loading = false;
                return;
            }

            var ev = result.Value;
            backGuildId = ev.GuildId;
            title = ev.Title;
            description = ev.Description;
            duration = ev.DurationMinutes;
            location = ev.Location;
            imageUrl = ev.ImageUrl;
            recurrenceSummary = ev.RecurrenceSummary;
            editTargetIsLive = ev.Status is EventStatus.Scheduled or EventStatus.Started;
            attendeeRoleId = ev.AttendeeRoleId;
            // Per-event transient state must not survive component reuse — a stale checked
            // value would silently clear the next event's role on save.
            clearAttendeeRole = false;
            clearRsvpClose = false;
            rsvpClose = "";
            currentRsvpClose = ev.RsvpClosesAtUtc;
            optionRows = [.. ev.Options.OrderBy(o => o.SortOrder).Select(o => new OptionRow
            {
                Emote = o.Emote,
                Label = o.Label,
                Capacity = o.Capacity,
                IsAttending = o.Id == ev.AttendingOption?.Id,
            })];
            loadedOptionSpecs = ToSpecs(optionRows);
        }

        loading = false;
    }

    private async Task PreviewUntilAsync()
    {
        untilPreview = null;
        untilError = null;
        if (string.IsNullOrWhiteSpace(repeatUntil))
        {
            return;
        }

        var result = await Api.ParseDateTimeAsync(new ParseDateTimeRequest(repeatUntil, null, backGuildId));
        if (result.Success && result.Value is not null)
        {
            untilPreview = result.Value.Utc;
        }
        else
        {
            untilError = result.Error;
        }
    }

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        selectedTemplateId = Guid.TryParse(raw, out var id) ? id : null;
        if (SelectedTemplate is { } template)
        {
            ApplyTemplate(template);
        }
    }

    // Prefills every template-carried field (overwrites edits — the hint says so). The visible
    // values are what gets submitted; the TemplateId rides along only for the notification specs.
    private void ApplyTemplate(EventTemplateDto template)
    {
        title = template.Title;
        description = template.Description;
        duration = template.DurationMinutes;
        location = template.Location;
        imageUrl = template.ImageUrl;
        repeatKind = template.Recurrence switch
        {
            null => RepeatKind.None,
            { Unit: RecurrenceUnit.Day } => RepeatKind.Daily,
            { Unit: RecurrenceUnit.Week } => RepeatKind.Weekly,
            { Unit: RecurrenceUnit.Year } => RepeatKind.Yearly,
            { MonthlyMode: MonthlyMode.NthWeekday } => RepeatKind.MonthlyNthWeekday,
            _ => RepeatKind.MonthlySameDate,
        };
        repeatInterval = template.Recurrence?.Interval ?? 1;
        endMode = EndMode.Never; // templates never carry end conditions
    }

    // Editing a live occurrence of a running series needs the scope ask before submitting.
    private Task SaveClickedAsync()
    {
        if (IsEdit && recurrenceSummary is not null && editTargetIsLive)
        {
            askingScope = true;
            return Task.CompletedTask;
        }

        return SaveAsync(null);
    }

    private async Task PreviewAsync()
    {
        whenPreview = null;
        whenError = null;
        if (string.IsNullOrWhiteSpace(when))
        {
            return;
        }

        var result = await Api.ParseDateTimeAsync(new ParseDateTimeRequest(when, null, backGuildId));
        if (result.Success && result.Value is not null)
        {
            whenPreview = result.Value.Utc;
        }
        else
        {
            whenError = result.Error;
        }
    }

    private async Task SaveAsync(EditScope? scope)
    {
        error = null;
        askingScope = false;
        if (string.IsNullOrWhiteSpace(title) || (!IsEdit && string.IsNullOrWhiteSpace(when)))
        {
            error = "Title and time are required.";
            return;
        }

        // Friendlier than the API's 400 for the same rules (which still enforce them regardless).
        if (optionRows.Any(r => string.IsNullOrWhiteSpace(r.Label) || string.IsNullOrWhiteSpace(r.Emote)))
        {
            error = "Every RSVP option needs an emoji and a label.";
            return;
        }

        // Only a CHANGED option editor submits options on edit. An unchanged set is a no-op
        // for the occurrence (options match by label) but not for a Series-scoped edit — it
        // would rewrite the series template from this occurrence's rows, turning a one-off
        // divergence into the template on an unrelated title edit — and a stale form must not
        // overwrite concurrent option changes.
        var optionSpecs = ToSpecs(optionRows);
        var optionsChanged = loadedOptionSpecs is null || !optionSpecs.SequenceEqual(loadedOptionSpecs);

        // A chosen end mode with a blank input would silently create a never-ending series.
        if (!IsEdit && repeatKind != RepeatKind.None)
        {
            if (repeatInterval is < 1 or > 12)
            {
                error = "Repeat interval must be between 1 and 12.";
                return;
            }

            if (endMode == EndMode.Until && string.IsNullOrWhiteSpace(repeatUntil))
            {
                error = "Enter the date the event should stop repeating, or choose a different end option.";
                return;
            }

            if (endMode == EndMode.Count && repeatCount is null)
            {
                error = "Enter how many times the event should repeat, or choose a different end option.";
                return;
            }
        }

        busy = true;
        if (IsEdit)
        {
            var result = await Api.UpdateEventAsync(EventId!.Value, new UpdateEventRequest(
                0, // EditorId is ignored for web callers — identity comes from the session.
                Title: title,
                WhenText: string.IsNullOrWhiteSpace(when) ? null : when,
                Description: description,
                DurationMinutes: duration,
                Location: location,
                ImageUrl: imageUrl,
                Scope: scope,
                // Clearing is allowed from the web; picking a role is bot-only (no role list here).
                ClearAttendeeRole: clearAttendeeRole,
                RsvpOptions: optionsChanged ? optionSpecs : null,
                RsvpCloseText: string.IsNullOrWhiteSpace(rsvpClose) ? null : rsvpClose,
                ClearRsvpClose: clearRsvpClose));
            busy = false;
            if (!result.Success || result.Value is null)
            {
                error = result.Error;
                return;
            }

            Nav.NavigateTo($"/app/events/{result.Value.Id}");
        }
        else
        {
            var recurrence = repeatKind switch
            {
                RepeatKind.Daily => new RecurrenceRuleDto(RecurrenceUnit.Day, repeatInterval),
                RepeatKind.Weekly => new RecurrenceRuleDto(RecurrenceUnit.Week, repeatInterval),
                RepeatKind.MonthlySameDate => new RecurrenceRuleDto(RecurrenceUnit.Month, repeatInterval),
                RepeatKind.MonthlyNthWeekday => new RecurrenceRuleDto(RecurrenceUnit.Month, repeatInterval, MonthlyMode.NthWeekday),
                RepeatKind.Yearly => new RecurrenceRuleDto(RecurrenceUnit.Year, repeatInterval),
                _ => null,
            };
            var result = await Api.CreateEventAsync(GuildId, new CreateEventRequest(
                0, // CreatorId is forced server-side to the signed-in user.
                title, when, 0, description, duration, location, imageUrl,
                recurrence,
                recurrence is not null && endMode == EndMode.Until && !string.IsNullOrWhiteSpace(repeatUntil) ? repeatUntil : null,
                recurrence is not null && endMode == EndMode.Count ? repeatCount : null,
                // The visible fields are explicit values (they win); the template id rides along
                // so the server attaches its notification specs. NoRecurrence protects a rule
                // the user cleared on a repeating template.
                selectedTemplateId,
                NoRecurrence: SelectedTemplate?.Recurrence is not null && repeatKind == RepeatKind.None,
                WantsThread: wantsThread,
                RsvpOptions: optionSpecs,
                RsvpCloseText: string.IsNullOrWhiteSpace(rsvpClose) ? null : rsvpClose));
            busy = false;
            if (!result.Success || result.Value is null)
            {
                error = result.Error;
                return;
            }

            Nav.NavigateTo($"/app/events/{result.Value.Id}");
        }
    }

    private void Back() => Nav.NavigateTo(IsEdit ? $"/app/events/{EventId}" : $"/app/guilds/{backGuildId}/events");
}
