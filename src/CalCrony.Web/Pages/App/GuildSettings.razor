@page "/app/guilds/{GuildId:long}/settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject CalCronyWebApiClient Api
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageTitle>Server settings — CalCrony</PageTitle>

<p class="meta-mono text-uppercase mb-2"><a href="/app/guilds/@GuildId/events">← Back to events</a></p>
<h1 class="h3">Server settings</h1>
@if (!isManager)
{
    <p class="text-body-secondary">Read-only — server managers can edit these here or in Discord with <code>/settings</code>.</p>
}

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="card p-3 h-100">
                <div class="fw-bold">Timezone</div>
                @if (isManager)
                {
                    <label class="form-label small mt-2 mb-1" for="gs-tz">Pick the server's timezone</label>
                    <div class="d-flex gap-2">
                        <TimeZonePicker Id="gs-tz" @bind-Value="timezoneInput" />
                        <button class="btn btn-outline-primary btn-sm" @onclick="SaveTimezoneAsync" disabled="@busy">Save</button>
                    </div>
                    @if (saveMessage is not null)
                    {
                        <div class="meta-mono mt-2">@saveMessage</div>
                    }
                }
                else
                {
                    <p class="meta-mono mb-0 mt-2">@(settings?.TimeZone ?? "…")</p>
                }
                <div class="mt-3 pt-2 border-top">
                    <div class="fw-bold small">Default events channel</div>
                    <p class="meta-mono mb-1 mt-1">@(settings?.DefaultChannelId is long ch ? $"#{ch}" : "not set")</p>
                    <p class="text-body-secondary small mb-0">Set in Discord with <code>/settings default-channel</code> — the web has no channel list. Web-created events and reminders post there.</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card p-3 h-100">
                <div class="fw-bold">Discord native events</div>
                @if (isManager)
                {
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="gs-native" @bind="mirrorInput" />
                        <label class="form-check-label small" for="gs-native">Mirror events into the server's Events tab</label>
                    </div>
                    <button class="btn btn-outline-primary btn-sm align-self-start mt-1" @onclick="SaveMirrorAsync" disabled="@busy">Save</button>
                    @if (mirrorMessage is not null)
                    {
                        <div class="meta-mono mt-2">@mirrorMessage</div>
                    }
                }
                else
                {
                    <p class="meta-mono mb-0 mt-2">@(settings?.MirrorNativeEvents == true ? "on" : "off")</p>
                }
                <p class="text-body-secondary small mb-0 mt-2">
                    The bot needs the <b>Manage Events</b> permission. Servers that invited it before this
                    feature must re-invite with the updated link or grant Manage Events to the bot's role.
                    Existing events mirror when next edited.
                </p>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card p-3 h-100">
                <div class="fw-bold">Calendar feed</div>
                <p class="text-body-secondary small mt-1 mb-2">Subscribe from Google, Apple, or Outlook — anyone with this URL can read this server's events.</p>
                @if (feedUrl is null)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                }
                else
                {
                    <p class="meta-mono text-break mb-2">@feedUrl</p>
                    <button class="btn btn-outline-primary btn-sm align-self-start" @onclick="CopyAsync">@copyLabel</button>
                }
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card p-3 h-100">
                <div class="fw-bold">Public calendar</div>
                <p class="text-body-secondary small mt-1 mb-2">
                    Off by default. When on, anyone with the link sees this server's event titles, times, and
                    locations as a month calendar — no sign-in needed. Descriptions, RSVPs, and member names never appear there.
                </p>
                @if (publicCalendar is null)
                {
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                }
                else
                {
                    @if (isManager)
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="gs-public-cal" checked="@publicCalendar.Enabled" @onchange="TogglePublicCalendarAsync" disabled="@busy" />
                            <label class="form-check-label small" for="gs-public-cal">Share a public calendar link</label>
                        </div>
                    }
                    else
                    {
                        <p class="meta-mono mb-1">@(publicCalendar.Enabled ? "on" : "off")</p>
                    }
                    @if (publicCalendar.Enabled && PublicCalendarUrl is { } link)
                    {
                        <p class="meta-mono text-break mb-2 mt-2"><a href="@link" target="_blank" rel="noopener">@link</a></p>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <button class="btn btn-outline-primary btn-sm" @onclick="CopyPublicCalendarAsync">@publicCopyLabel</button>
                            @if (isManager && !confirmRegenerate)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmRegenerate = true" disabled="@busy">New link…</button>
                            }
                            else if (isManager)
                            {
                                <span class="small">Old links stop working.</span>
                                <button class="btn btn-danger btn-sm" @onclick="RegeneratePublicCalendarAsync" disabled="@busy">Generate new link</button>
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmRegenerate = false">Cancel</button>
                            }
                        </div>
                    }
                    @if (publicCalendarMessage is not null)
                    {
                        <div class="meta-mono mt-2">@publicCalendarMessage</div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long GuildId { get; set; }

    private GuildSettingsDto? settings;
    private string? feedUrl;
    private string? error;
    private string copyLabel = "Copy URL";
    private bool isManager;
    private bool busy;
    private string timezoneInput = "";
    private string? saveMessage;
    private bool mirrorInput;
    private string? mirrorMessage;
    private PublicCalendarSettingsDto? publicCalendar;
    private string? publicCalendarMessage;
    private string publicCopyLabel = "Copy link";
    private bool confirmRegenerate;

    // The API's absolute Url (from Web:Origin) is canonical; without one, the link is built from
    // this app's own origin — the calendar is a web-app route, not an API one.
    private string? PublicCalendarUrl => publicCalendar?.Url
        ?? (publicCalendar?.Path is { } path ? Nav.ToAbsoluteUri(path.TrimStart('/')).ToString() : null);

    protected override async Task OnParametersSetAsync()
    {
        var settingsResult = await Api.GetGuildSettingsAsync(GuildId);
        if (!settingsResult.Success)
        {
            error = settingsResult.Error;
            return;
        }

        settings = settingsResult.Value;
        timezoneInput = settings?.TimeZone ?? "UTC";
        mirrorInput = settings?.MirrorNativeEvents ?? false;
        isManager = (await Api.GetMyGuildsAsync()).Value?.Guilds
            .Any(g => g.Id == GuildId && g.CanManage) ?? false;

        var feedResult = await Api.GetFeedTokenAsync(GuildId);
        if (feedResult.Success && feedResult.Value is not null)
        {
            feedUrl = Api.FeedUrl(feedResult.Value);
        }

        confirmRegenerate = false;
        publicCalendarMessage = null;
        var publicResult = await Api.GetPublicCalendarSettingsAsync(GuildId);
        publicCalendar = publicResult.Success ? publicResult.Value : new PublicCalendarSettingsDto(false, null, null, null);
    }

    private Task TogglePublicCalendarAsync(ChangeEventArgs e)
    {
        var enable = e.Value is true;
        return SavePublicCalendarAsync(new PublicCalendarRequest(enable), enable
            ? "🔗 On — share the link below. Turn it off any time; a new link retires the old one."
            : "🔒 Off — the old link no longer works.");
    }

    private Task RegeneratePublicCalendarAsync()
    {
        confirmRegenerate = false;
        return SavePublicCalendarAsync(
            new PublicCalendarRequest(true, Regenerate: true), "🔗 New link generated — the previous one no longer works.");
    }

    private async Task SavePublicCalendarAsync(PublicCalendarRequest request, string successMessage)
    {
        publicCalendarMessage = null;
        busy = true;
        var result = await Api.PutPublicCalendarAsync(GuildId, request);
        busy = false;
        if (!result.Success || result.Value is null)
        {
            publicCalendarMessage = $"❌ {result.Error}";
            return;
        }

        publicCalendar = result.Value;
        publicCalendarMessage = successMessage;
    }

    private async Task CopyPublicCalendarAsync()
    {
        var ok = await Js.InvokeAsync<bool>("calcronyCopy", PublicCalendarUrl);
        publicCopyLabel = ok ? "Copied ✓" : "Copy failed";
        await Task.Delay(1500);
        publicCopyLabel = "Copy link";
    }

    private async Task SaveTimezoneAsync()
    {
        saveMessage = null;
        var trimmed = timezoneInput.Trim();
        if (trimmed.Length == 0)
        {
            saveMessage = "❌ Enter an IANA timezone id, e.g. America/Chicago.";
            return;
        }

        busy = true;
        // Read-modify-write: preserve the bot-managed DefaultChannelId and the mirror flag.
        var result = await Api.PutGuildSettingsAsync(GuildId, new GuildSettingsDto(
            trimmed, settings?.DefaultChannelId, settings?.MirrorNativeEvents ?? false));
        busy = false;
        if (!result.Success || result.Value is null)
        {
            saveMessage = $"❌ {result.Error}";
            return;
        }

        settings = result.Value;
        saveMessage = $"🌍 Saved — {result.Value.TimeZone}.";
    }

    private async Task SaveMirrorAsync()
    {
        mirrorMessage = null;
        busy = true;
        // Read-modify-write: preserve the timezone and the bot-managed DefaultChannelId.
        var result = await Api.PutGuildSettingsAsync(GuildId, new GuildSettingsDto(
            settings?.TimeZone ?? "UTC", settings?.DefaultChannelId, mirrorInput));
        busy = false;
        if (!result.Success || result.Value is null)
        {
            mirrorMessage = $"❌ {result.Error}";
            return;
        }

        settings = result.Value;
        mirrorMessage = result.Value.MirrorNativeEvents
            ? "📅 On — new events will appear in the server's Events tab."
            : "📅 Off — existing mirrored events stay until they finish.";
    }

    private async Task CopyAsync()
    {
        var ok = await Js.InvokeAsync<bool>("calcronyCopy", feedUrl);
        copyLabel = ok ? "Copied ✓" : "Copy failed";
        await Task.Delay(1500);
        copyLabel = "Copy URL";
    }
}
